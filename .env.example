# Anthropic API Key for invoice parsing + daily commit digest
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# Google Service Account JSON (paste entire JSON content as single line)
# Get this from Google Cloud Console -> IAM & Admin -> Service Accounts -> Create Key (JSON)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# SMTP credentials for scripts/daily_digest.py (Daily Commits Digest workflow)
# Defaults target Office365; change SMTP_HOST for Gmail/other providers.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=client@autoworld.ro
SMTP_PASSWORD=xxxxxxxx
SMTP_FROM_EMAIL=client@autoworld.ro
SMTP_FROM_NAME=JARVIS Digest
